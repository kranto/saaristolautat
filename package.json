  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-redux": "7.2.9",
    "react-transition-group": "4.4.5",
    "redux": "4.2.1",
    "redux-logger": "^3.0.6",
    "redux-promise-middleware": "5.1.1",

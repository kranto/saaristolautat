  "scripts": {
    "start": "vite",
    "build": "mv public/data .data.save; VITE_APP_VERSION=$(date +'%Y%m%d%H%M%S') vite build; status=$?; mv .data.save public/data; exit $status",
    "copytest": "scp -r build/* dh:test/",
    "copystaging": "scp -r build/* dh:prod/staging/",
    "copyprod": "scp -r build/* dh:prod/"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lato-font": "^3.0.0",
    "vite": "^8.3.2"
  }

{
  "name": "saaristolautat",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-redux": "5.1.2",
    "react-scripts": "^2.1.3",
    "react-transition-group": "^1.0.0",
    "redux": "4.2.1",
    "redux-logger": "^3.0.6",
    "redux-promise-middleware": "^5.1.1",
    "redux-thunk": "2.4.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "mv public/data .data.save; REACT_APP_VERSION=$(date +'%Y%m%d%H%M%S') react-scripts build; mv .data.save public/data",
    "copytest": "scp -r build/* dh:test/",
    "copystaging": "scp -r build/* dh:prod/staging/",
    "copyprod": "scp -r build/* dh:prod/",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "lato-font": "^3.0.0"
  }
}
